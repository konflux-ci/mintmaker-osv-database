{
  "extends": [
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "tekton": {
    "enabled": true,
    "automergeType": "pr",
    "automerge": true,
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "description": "Automerge digest updates for Red Hat published images",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "matchPackageNames": [
        "/^registry\\.access\\.redhat\\.com\\//",
        "/^registry\\.redhat\\.io\\//"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
